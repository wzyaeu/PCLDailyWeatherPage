<StackPanel>
    <TextBlock HorizontalAlignment="Center"
               FontSize="12"
               Foreground="{DynamicResource ColorBrush1}"
               Text="{time}"/>
    <Border Background="{DynamicResource ColorBrush7}"
            CornerRadius="{border_radius}"
            Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal"
                    Margin="4,5">
            <TextBlock Margin="0,0,2,0"
                       VerticalAlignment="Center"
                       FontSize="22"
                       Foreground="{DynamicResource ColorBrush3}"
                       Text="{temp}°"/>
            <Border
                ToolTip="{weather_text}"
                HorizontalAlignment="Center"
                Background="{DynamicResource ColorBrush7}">
                <Path Margin="0"
                      Width="25"
                      Height="25"
                      Stretch="Uniform"
                      Fill="{DynamicResource ColorBrush3}"
                      Data="{weather_icon}"/>
            </Border>
        </StackPanel>
    </Border>
    <Border Background="{DynamicResource ColorBrush7}"
            CornerRadius="{border_radius}"
            Margin="0,4,0,0">
        <StackPanel Margin="5">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource ColorBrush4}"
                       Text="{wind_scale}级 {wind_text}"/>
            <StackPanel Margin="0,3,0,0"/>
            <TextBlock HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource ColorBrush4}"
                       Text="{humi}%/{uv}"
                       ToolTip="湿度/紫外线"/>
        </StackPanel>
    </Border>
</StackPanel>