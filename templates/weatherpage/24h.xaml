<Border Background="{DynamicResource ColorBrush7}"
        CornerRadius="5"
        Margin="0,0,5,0">
    <StackPanel  Margin="5">
        <TextBlock HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ColorBrush1}"
                   Text="{time}"/>
        <TextBlock Margin="0,5,0,0"
                   HorizontalAlignment="Center"
                   FontSize="22"
                   Foreground="{DynamicResource ColorBrush3}"
                   Text="{temp}°"/>
        <Border
            ToolTip="{weather_text}"
            HorizontalAlignment="Center"
            Background="{DynamicResource ColorBrush7}">
            <Path Margin="0,2,0,5"
                  Width="25"
                  Height="25"
                  Stretch="Uniform"
                  Fill="{DynamicResource ColorBrush3}"
                  Data="{weather_icon}"/>
        </Border>
        <TextBlock Margin="3,1"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource ColorBrush4}"
                   Text="{wind}km/h"/>
        <TextBlock Margin="3,1"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource ColorBrush4}"
                   Text="湿度 {humi}%"/>
    </StackPanel>
</Border>
