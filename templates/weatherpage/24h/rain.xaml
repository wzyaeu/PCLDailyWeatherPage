<StackPanel Width="45">
    <TextBlock HorizontalAlignment="Center"
               FontSize="12"
               Foreground="{DynamicResource ColorBrush1}"
               Text="{time}"/>
    <StackPanel Margin="4,5">
        <Border
            ToolTip="{weather_text}"
            HorizontalAlignment="Center"
            CornerRadius="5"
            Background="{DynamicResource ColorBrush8}">
            <Path Margin="3"
                  Width="20"
                  Height="20"
                  Stretch="Uniform"
                  Fill="{DynamicResource ColorBrush3}"
                  Data="{weather_icon}"/>
        </Border>
    </StackPanel>
    <Border Background="{DynamicResource ColorBrush6}"
            CornerRadius="{border_radius}"
            Width="45"
            ToolTip="{time} {rain}mm"
            Height="104">
        <StackPanel
            VerticalAlignment="Bottom">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Margin="0,0,0,5"
                       Foreground="{DynamicResource ColorBrush3}"
                       Text="{rain}"/>
            <Border Background="{DynamicResource ColorBrush4}"
                    CornerRadius="5,5,0,0"
                    Margin="-2,0,0,0"
                    VerticalAlignment="Bottom"
                    Height="{h}"/>
        </StackPanel>
    </Border>
</StackPanel>