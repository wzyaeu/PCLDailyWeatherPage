<StackPanel Width="45">
    <TextBlock HorizontalAlignment="Center"
               FontSize="12"
               Foreground="{DynamicResource ColorBrush1}"
               Text="{time}"/>
    <StackPanel Margin="4,5">
        <Border
            ToolTip="{weather_text}"
            HorizontalAlignment="Center"
            CornerRadius="5"
            Background="{DynamicResource ColorBrush8}">
            <Path Margin="3"
                  Width="20"
                  Height="20"
                  Stretch="Uniform"
                  Fill="{DynamicResource ColorBrush3}"
                  Data="{weather_icon}"/>
        </Border>
    </StackPanel>
    <Grid>
        <Border Background="{DynamicResource ColorBrush6}"
                CornerRadius="5,5,0,0"
                Margin="0,0,0,0"
                VerticalAlignment="Bottom"
                Height="{h}"/>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                Margin="0,{rt_mag},0,0"
                    Orientation="Horizontal">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource ColorBrush4}"
                       Text="{rain}"/>
            <TextBlock FontSize="9"
                       Margin="0,3.5,0,0"
                       Foreground="{DynamicResource ColorBrush4}"
                       Text="mm"/>
        </StackPanel>
        <TextBlock Margin="0,{tt_mag},0,0"
                   HorizontalAlignment="Center"
                   FontSize="17"
                   Foreground="{DynamicResource ColorBrush3}"
                   Text="{temp}°"/>
        <Grid Height="50"
              Margin="0,20,0,13"
              Width="45">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Line X1="22.5"
                      Y1="0"
                      X2="0"
                      Y2="{l1_y}"
                      Grid.Column="0"
                      StrokeThickness="2"
                      Margin="-1,0,-1,{l1_mag}"
                      VerticalAlignment="Bottom"
                      Visibility="{l1_vis}"
                      Stroke="{DynamicResource ColorBrush5}"/>
                <Line X1="22.5"
                      Y1="0"
                      X2="0"
                      Y2="{l2_y}"
                      Grid.Column="2"
                      StrokeThickness="2"
                      Margin="-1,0,-1,{l2_mag}"
                      VerticalAlignment="Bottom"
                      Visibility="{l2_vis}"
                      Stroke="{DynamicResource ColorBrush5}"/>
            </Grid>
            <Border
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Width="6"
                Height="6"
                Margin="0,0,0,{tc_mag}"
                CornerRadius="3"
                Background="{DynamicResource ColorBrush3}">
            </Border>
        </Grid>
    </Grid>
    <StackPanel Margin="5,5,5,0">
        <TextBlock HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ColorBrush4}"
                   Text="{wind_scale}级"
                   ToolTip="{wind_speed}km/h"/>
        <TextBlock HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ColorBrush4}"
                   Text="{humi}%"
                   ToolTip="湿度"/>
    </StackPanel>
</StackPanel>