    </local:MyCard>
    <local:MyCard
        Margin="0,4">
        <TextBlock FontSize="13"
                   Foreground="{DynamicResource ColorBrush5}"
                   Text="更新于 {now_updatetime}"
                   Margin="10,10,0,0"/>
        <StackPanel Margin="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <Path Margin="0,0,10,0"
                              Width="55"
                              Height="55"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Fill="{DynamicResource ColorBrush3}"
                              Data="{now_weather_icon}"/>
                        <TextBlock FontSize="60"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{now_temp}°"
                                   Margin="0,-5,0,0"/>
                    </StackPanel>
                    <TextBlock FontSize="15"
                               Foreground="{DynamicResource ColorBrush4}"
                               Text="{now_weather} | {today_temp_max}° / {today_temp_min}° | 体感 {now_temp_feel}°"
                               Margin="0,0,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Line X1="0"
                      Grid.Column="2"
                      Y1="40"
                      X2="0"
                      Y2="0"
                      StrokeThickness="2"
                      VerticalAlignment="Center"
                      Stroke="{DynamicResource ColorBrush5}"
                      Margin="10,0"/>
                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,1">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="紫外线"/>
                        <TextBlock FontSize="15"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{now_uv}"/>
                        <TextBlock FontSize="15"
                                   Foreground="{DynamicResource ColorBrush5}"
                                   Text="/15"/>
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,1">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="云量"/>
                        <TextBlock FontSize="15"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{now_cloud}%"/>
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,1">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="风速"/>
                        <TextBlock FontSize="15"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{now_wind}km/h"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </local:MyCard>
    <local:MyCard
        Margin="0,4">
        <StackPanel Margin="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBlock FontSize="15"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush3}"
                               Text="日出时间"/>
                    <TextBlock FontSize="15"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush4}"
                               Text="{attr1_sunrise}"/>
                    <Line X2="60"
                          StrokeThickness="2"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource ColorBrush5}"
                          Margin="7,0"/>
                    <TextBlock FontSize="15"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,3,0"
                               Foreground="{DynamicResource ColorBrush4}"
                               Text="{attr1_sunset}"/>
                    <TextBlock FontSize="15"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush3}"
                               Text="日落时间"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </local:MyCard>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="17"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ColorBrush3}"
                   Text="未来天气"/>
        <Line X1="0"
              Grid.Column="1"
              Y1="0"
              X2="1000"
              Y2="0"
              StrokeThickness="2"
              VerticalAlignment="Center"
              Stroke="{DynamicResource ColorBrush3}"
              Margin="10,0"/>
    </Grid>
    <local:MyCard
        Margin="0,4">
        <StackPanel Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource 7DayScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Orientation="Horizontal">
                    {24h}
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </local:MyCard>
    <local:MyCard
        Margin="0,4">
        <StackPanel Margin="10,10,10,5">
            {7d}
        </StackPanel>
    </local:MyCard>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
